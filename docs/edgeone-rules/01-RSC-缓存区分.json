{
  "FormatVersion": "1.0",
  "Rules": [
    {
      "RuleName": "RSC 缓存区分",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space']",
          "Actions": [
            {
              "Name": "CacheKey",
              "CacheKeyParameters": {
                "Header": {
                  "Switch": "on",
                  "Values": [
                    "RSC",
                    "Next-Router-Prefetch"
                  ]
                }
              }
            }
          ]
        }
      ],
      "Description": []
    }
  ]
}