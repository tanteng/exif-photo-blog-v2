{
  "FormatVersion": "1.0",
  "Rules": [
    {
      "RuleName": "动态页面边缘缓存",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space'] and ${http.request.uri.path} matches '^/(p|tag|album|camera|lens|recipe|film|focal|year|shot-on|grid|full|recents)/'",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "CustomTime": {
                  "Switch": "on",
                  "IgnoreCacheControl": "on",
                  "CacheTime": 86400
                }
              }
            },
            {
              "Name": "CachePrefresh",
              "CachePrefreshParameters": {
                "Switch": "on",
                "CacheTimePercent": 90
              }
            },
            {
              "Name": "OfflineCache",
              "OfflineCacheParameters": {
                "Switch": "on"
              }
            }
          ]
        }
      ],
      "Description": [
        "合并所有动态页面缓存规则：照片详情/OG图片、标签、相册、相机、镜头、配方、胶片、焦距、年份、shot-on、网格、全幅、最近"
      ]
    }
  ]
}