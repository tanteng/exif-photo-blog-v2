{
  "FormatVersion": "1.0",
  "Rules": [
    {
      "RuleName": "RSC 缓存区分",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space']",
          "Actions": [
            {
              "Name": "CacheKey",
              "CacheKeyParameters": {
                "Header": {
                  "Switch": "on",
                  "Values": [
                    "RSC",
                    "Next-Router-Prefetch"
                  ]
                }
              }
            }
          ]
        }
      ],
      "Description": []
    },
    {
      "RuleName": "edge-cache-photo-og",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space'] and ${http.request.uri.path} like ['/p/*/image']",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "CustomTime": {
                  "Switch": "on",
                  "CacheTime": 86400
                }
              }
            },
            {
              "Name": "CachePrefresh",
              "CachePrefreshParameters": {
                "Switch": "on"
              }
            },
            {
              "Name": "OfflineCache",
              "OfflineCacheParameters": {
                "Switch": "on"
              }
            }
          ]
        }
      ],
      "Description": []
    },
    {
      "RuleName": "edge-cache-photo-page",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space'] and ${http.request.uri.path} like ['/p/*']",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "CustomTime": {
                  "Switch": "on",
                  "CacheTime": 86400
                }
              }
            },
            {
              "Name": "CachePrefresh",
              "CachePrefreshParameters": {
                "Switch": "on"
              }
            },
            {
              "Name": "OfflineCache",
              "OfflineCacheParameters": {
                "Switch": "on"
              }
            }
          ]
        }
      ],
      "Description": []
    },
    {
      "RuleName": "edge-cache-listing",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['photos.tanteng.space'] and ${http.request.uri.path} like ['/tag/*', '/album/*', '/camera/*', '/lens/*', '/recipe/*', '/film/*', '/focal/*', '/year/*', '/shot-on/*', '/grid/*', '/full/*', '/recents/*']",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "CustomTime": {
                  "Switch": "on",
                  "CacheTime": 86400
                }
              }
            },
            {
              "Name": "CachePrefresh",
              "CachePrefreshParameters": {
                "Switch": "on"
              }
            },
            {
              "Name": "OfflineCache",
              "OfflineCacheParameters": {
                "Switch": "on"
              }
            }
          ]
        }
      ],
      "Description": []
    }
  ]
}